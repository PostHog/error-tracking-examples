{
  "name": "node-raw",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Node.js app instrumented with PostHog error tracking, using the raw posthog-cli to inject chunk IDs and upload source maps (no bundler plugin).",
  "scripts": {
    "build": "esbuild src/*.ts --outdir=dist --platform=node --format=cjs --minify --sourcemap",
    "process": "CLI=/Users/ablaszkiewicz/Documents/repos/posthog/cli/target/debug/posthog-cli; $CLI --env-file .env sourcemap inject --directory ./dist --experimental-release-injection && $CLI --env-file .env sourcemap upload --directory ./dist",
    "start": "pnpm build && pnpm process && node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "posthog-node": "^5.38.4"
  },
  "devDependencies": {
    "@posthog/cli": "latest",
    "esbuild": "^0.25.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@posthog/cli", "esbuild"]
  }
}
