{
  "name": "react-native-expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "Minimal Expo app instrumented with PostHog error tracking. `pnpm sourcemaps` exports the hermes bundles with Expo's built-in debug ids and uploads them with the local posthog-cli, exercising the hermes path that adopts a map's `debugId` as the chunk id.",
  "scripts": {
    "clean": "rm -rf dist",
    "export": "expo export --source-maps --platform ios",
    "upload": "../../posthog/cli/target/debug/posthog-cli hermes upload --directory dist",
    "sourcemaps": "pnpm clean && pnpm export && pnpm upload",
    "start": "expo start --port 8083",
    "start:ios": "expo run:ios --port 8083",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --clean",
    "start:ios:release": "expo run:ios --configuration Release --port 8083"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-application": "~7.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-localization": "~17.0.0",
    "posthog-react-native": "^4.60.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  }
}
