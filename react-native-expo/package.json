{
  "name": "react-native-expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "Minimal Expo app instrumented with PostHog error tracking. `pnpm sourcemaps` exports the hermes bundles with Expo's built-in debug ids and uploads them with posthog-cli, exercising the hermes path that adopts a map's `debugId` as the chunk id; `pnpm sourcemaps:releaseless` runs the same upload with --release-mode=event.",
  "scripts": {
    "clean": "rm -rf dist",
    "export": "expo export --source-maps --platform ios",
    "upload": "posthog-cli --dotenv-file .env hermes upload --directory dist --release-name ${APP_ID:-com.posthog.example.rnexpo} --release-version ${APP_VERSION:-1.0.0} --build ${APP_BUILD:-1}",
    "upload:releaseless": "../bin/posthog-cli-local --dotenv-file .env hermes upload --directory dist --release-name ${APP_ID:-com.posthog.example.rnexpo} --release-version ${APP_VERSION:-1.0.0} --build ${APP_BUILD:-1} --release-mode=event",
    "sourcemaps": "pnpm clean && pnpm export && pnpm upload",
    "sourcemaps:releaseless": "pnpm clean && pnpm export && pnpm upload:releaseless",
    "start": "expo start --port 8083",
    "ios": "bin/run-ios legacy",
    "ios:releaseless": "bin/run-ios releaseless",
    "start:ios": "expo run:ios --port 8083",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform ios --clean",
    "start:ios:release": "expo run:ios --configuration Release --port 8083"
  },
  "dependencies": {
    "@posthog/react-native-plugin": "file:./vendor/posthog-react-native-plugin.tgz",
    "expo": "^54.0.0",
    "expo-application": "~7.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-localization": "~17.0.0",
    "posthog-react-native": "file:./vendor/posthog-react-native.tgz",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@posthog/cli": "^0.13.3"
  }
}
