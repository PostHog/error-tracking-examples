#!/usr/bin/env bash
# Install posthog-php from its working copy, resolve the release with posthog-cli, export its id as
# POSTHOG_RELEASE_ID, and run the app. The SDK reads POSTHOG_RELEASE_ID when the client is created
# and reports it as $release_id on every event. PHP frames carry their own source context, so there
# is no symbol set to upload. Pass a version to ship the same code as a second release:
# APP_VERSION=2.0.0 ./run.
set -euo pipefail
cd "$(dirname "$0")"

APP_NAME=php-release-env
APP_VERSION=${APP_VERSION:-1.0.0}

if ! command -v composer >/dev/null; then
  echo "error: composer not found — install it (brew install composer)" >&2
  exit 1
fi

# A copy of the working copy (a path repository with symlink off), not the Packagist release,
# because reading the release id from POSTHOG_RELEASE_ID has not shipped in a release yet. Update
# rather than install, so every run copies the working copy again.
rm -rf vendor composer.lock
composer update --quiet --no-interaction

# Create (or look up) the release and capture its id. `release resolve` prints only the id.
RELEASE_ID=$(../bin/posthog-cli-local --dotenv-file .env release resolve \
  --release-name "$APP_NAME" --release-version "$APP_VERSION")

# The app takes the key and host from the process environment, and the SDK takes the release id
# from POSTHOG_RELEASE_ID.
set -a
. ./.env
set +a
export POSTHOG_RELEASE_ID=$RELEASE_ID
echo "running $APP_NAME as release $APP_NAME@$APP_VERSION (POSTHOG_RELEASE_ID=$RELEASE_ID)"
exec php main.php
