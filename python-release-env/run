#!/usr/bin/env bash
# Build a wheel from the working copy of posthog-python, resolve the release with posthog-cli,
# export its id as POSTHOG_RELEASE_ID, and run the app. The SDK reads POSTHOG_RELEASE_ID at client
# init and reports it as $release_id on every event. Python frames carry their own source context,
# so there is no symbol set to upload. Pass a version to ship the same code as a second release:
# APP_VERSION=2.0.0 ./run.
set -euo pipefail
cd "$(dirname "$0")"

if ! command -v uv >/dev/null; then
  echo "error: uv not found — install it (https://docs.astral.sh/uv/)" >&2
  exit 1
fi

POSTHOG_PYTHON_REPO=${POSTHOG_PYTHON_REPO:-"$(cd ../../posthog-python && pwd)"}

# A real build, not an editable install, so the run also proves the new module ships in the wheel.
rm -rf vendor
uv build --quiet --wheel --out-dir vendor "$POSTHOG_PYTHON_REPO"
uv venv --quiet --allow-existing .venv
uv pip install --quiet --python .venv --reinstall vendor/posthog-*.whl

read -r APP_NAME PROJECT_VERSION < <(.venv/bin/python -c '
import tomllib
project = tomllib.load(open("pyproject.toml", "rb"))["project"]
print(project["name"], project["version"])')
APP_VERSION=${APP_VERSION:-$PROJECT_VERSION}

# Create (or look up) the release and capture its id. `release resolve` prints only the id.
RELEASE_ID=$(../bin/posthog-cli-local --dotenv-file .env release resolve \
  --release-name "$APP_NAME" --release-version "$APP_VERSION")

# The app takes the key and host from the process environment, and the SDK takes the release id
# from POSTHOG_RELEASE_ID.
set -a
. ./.env
set +a
export POSTHOG_RELEASE_ID=$RELEASE_ID
echo "running $APP_NAME as release $APP_NAME@$APP_VERSION (POSTHOG_RELEASE_ID=$RELEASE_ID)"
exec .venv/bin/python main.py
