#!/usr/bin/env python3
"""Report what PostHog made of the exceptions the Flutter web examples sent.

    bin/check-flutter              # both variants
    bin/check-flutter releaseless  # one of them

For each release of each variant it prints the $release_id the SDK read out of the chunk (event
mode only), the release the server resolved, the chunk ids the frames carry, and the in-app frames
after symbolication with the source context of the deepest one.

  - a frame that reads main.dart.js with a mangled name means the sourcemap never landed, or the
    chunk id differs
  - "$release_id: (none ...)" is expected in legacy mode, where the release rides on the symbol set
  - no source context is expected: `flutter build web --source-maps` writes no sourcesContent, so
    the server has the names and the line numbers but not the lines themselves

Whether the two releases shared one symbol set is read off the upload, not off the event: the
run prints "1 skipped (1 already present)" in event mode and "1 chunk(s) uploaded" in legacy.

Reads credentials from the repo root .env. Uses the local dev login, because the query endpoint
needs more than the error_tracking scope the stored personal API key carries.
"""

import json
import sys
import urllib.error
import urllib.request
from http.cookiejar import CookieJar
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEV_EMAIL = "test@posthog.com"
DEV_PASSWORD = "12345678"


def read_env() -> dict:
    env_file = ROOT / ".env"
    if not env_file.exists():
        sys.exit("error: no .env at the repo root — run bin/copy-env first")
    values = {}
    for line in env_file.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    return values


def login(host: str):
    jar = CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
    opener.cookiejar = jar
    attempts = (
        (f"{host}/api/login/dev", {"email": DEV_EMAIL}),
        (f"{host}/api/login", {"email": DEV_EMAIL, "password": DEV_PASSWORD}),
    )
    for url, payload in attempts:
        request = urllib.request.Request(
            url, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"}
        )
        try:
            opener.open(request, timeout=10)
            return opener
        except urllib.error.HTTPError:
            continue
    sys.exit(f"error: could not log in to {host} as {DEV_EMAIL} — is the dev stack up?")


def post(opener, url: str, payload: dict) -> dict:
    csrf = next((c.value for c in opener.cookiejar if c.name == "posthog_csrftoken"), "")
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "X-CSRFToken": csrf},
    )
    with opener.open(request, timeout=60) as response:
        return json.load(response)


def query(opener, host: str, hogql: str) -> list:
    return post(opener, f"{host}/api/projects/1/query/", {"query": {"kind": "HogQLQuery", "query": hogql}}).get(
        "results", []
    )


def as_json(value):
    if isinstance(value, str):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return None
    return value


def frames_of(exception_list) -> list:
    collected = []
    for exception in exception_list or []:
        collected.extend(((exception.get("stacktrace") or {}).get("frames")) or [])
    return collected


def print_context(opener, host: str, frame: dict) -> None:
    raw_id = frame.get("raw_id")
    if not raw_id:
        return
    results = post(
        opener,
        f"{host}/api/projects/1/error_tracking/stack_frames/batch_get/",
        {"raw_ids": [raw_id]},
    ).get("results", [])
    context = (results[0].get("context") if results else None) or {}
    if not context:
        print("      (no source context)")
        return
    for item in (context.get("before") or [])[-2:]:
        print(f"      {item['number']:>4}   {item['line']}")
    current = context.get("line") or {}
    print(f"      {current.get('number'):>4} > {current.get('line')}")
    for item in (context.get("after") or [])[:2]:
        print(f"      {item['number']:>4}   {item['line']}")


def main() -> None:
    wanted = sys.argv[1] if len(sys.argv) > 1 else None
    env = read_env()
    host = env.get("POSTHOG_HOST", "http://localhost:8010")
    opener = login(host)

    rows = query(
        opener,
        host,
        """
        select
            JSONExtractString(properties.$exception_release, 'project') as project,
            JSONExtractString(properties.$exception_release, 'version') as version,
            properties.$release_id,
            properties.$exception_list,
            timestamp
        from events
        where event = '$exception'
          and properties.$lib = 'posthog-flutter'
          and timestamp > now() - interval 3 hour
        order by timestamp desc
        limit 40
        """,
    )
    if not rows:
        print("no $exception events from the Flutter web examples in the last 3 hours")
        return

    seen = set()
    for project, version, release_id, exception_list, timestamp in rows:
        variant = "releaseless" if str(project).endswith("releaseless") else "legacy"
        # One block per release of each variant, so a second release shows next to its first.
        key = (variant, version)
        if (wanted and variant != wanted) or key in seen:
            continue
        seen.add(key)

        frames = frames_of(as_json(exception_list))
        app_frames = [f for f in frames if str(f.get("source", "")).startswith("../")]

        print(f"\n  {variant} {version}  ({str(timestamp)[:19]})")
        print(f"    $release_id     : {release_id or '(none — resolved via symbol set)'}")
        print(f"    release         : {project}@{version}" if project else "    release         : none resolved")

        print("    frames (in app) :")
        for frame in app_frames:
            mark = "✓" if frame.get("resolved") else "✗"
            print(f"      {mark} {frame.get('source')}:{frame.get('line')} {frame.get('resolved_name')}")
        if not app_frames:
            print("      (none resolved into the app)")
        else:
            print("    source context of the deepest frame:")
            print_context(opener, host, app_frames[-1])


if __name__ == "__main__":
    main()
