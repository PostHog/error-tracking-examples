#!/usr/bin/env bash
# Release build of the Flutter web app, then the legacy upload: the release the
# upload creates is stamped into the sourcemap, so the symbol set is bound to it
# and an exception inherits the release of the symbol set its frames resolved
# against. Pass a version to ship the same code again as a second release:
# `APP_VERSION=2.0.0 ./run`.
set -euo pipefail
cd "$(dirname "$0")"
. ../bin/flutter-web-lib

VARIANT=flutter-web-legacy
APP_VERSION=${APP_VERSION:-1.0.0}
PORT=${PORT:-7801}

flutter_web_build "$VARIANT" "$VARIANT@$APP_VERSION"
posthog_cli sourcemap process --directory build/web \
  --release-name "$VARIANT" --release-version "$APP_VERSION"
flutter_web_serve "$VARIANT" "$PORT"
